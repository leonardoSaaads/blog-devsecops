{
  // Fully static site: `next build` generates `out/` and Cloudflare serves it as
  // Workers Static Assets. No `main`: no code runs per request.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog-devsecops",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./out",
    // `/about` serves `about.html`; `/about/` redirects to `/about`.
    "html_handling": "auto-trailing-slash",
    // Unknown routes get `404.html` with a 404 status.
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
  // Explicit to silence deploy warnings. Canonical URLs point to NEXT_PUBLIC_SITE_URL;
  // disable these once the custom domain is confirmed, if you prefer.
  "workers_dev": true,
  "preview_urls": true,
}
