/**
 * Image variants generated at build time (`scripts/optimize-images.mts`).
 *
 * A static export has no Next image optimizer (`/_next/image`); every raster image in
 * `public/` gets WebP versions at the widths below, and the `next/image` loader points
 * the `srcset` to them.
 *
 * This file is also imported by the build script (plain Node, no bundler): use only
 * erasable TypeScript syntax and relative imports.
 */

/** Widths for responsive images (with `sizes` in vw, or `fill`). */
export const DEVICE_SIZES = [640, 960, 1280, 1920];

/** Widths for small, fixed-size images (avatars, icons). */
export const IMAGE_SIZES = [48, 96, 192, 256, 384];

/** Every width requested by `next/image` — and generated by the script. */
export const VARIANT_WIDTHS = [...IMAGE_SIZES, ...DEVICE_SIZES];

/** Variants folder, relative to `public/` (ignored by Git). */
export const VARIANTS_DIR = "_img";

/** Local PNG/JPEG files only; SVG and external URLs bypass the loader. */
const LOCAL_RASTER = /^\/(?:[\w-]+\/)*[\w.-]+\.(?:png|jpe?g)$/i;

export function isOptimizable(src: string): boolean {
  return (
    LOCAL_RASTER.test(src) && !src.split("/").includes("..") && !src.startsWith(`/${VARIANTS_DIR}/`)
  );
}

/** Public path of the nearest WebP variant (rounded up). */
export function variantPath(src: string, width: number): string | undefined {
  if (!isOptimizable(src)) return undefined;
  const size =
    VARIANT_WIDTHS.find((candidate) => candidate >= width) ??
    VARIANT_WIDTHS[VARIANT_WIDTHS.length - 1];
  return `/${VARIANTS_DIR}${src.replace(/\.[^.]+$/, "")}/${size}.webp`;
}
