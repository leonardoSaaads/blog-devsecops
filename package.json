    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.4",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "katex": "$katex",
