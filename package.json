    "geist": "^1.8.2",
    "hast-util-to-string": "^3.0.1",
    "image-size": "^2.0.4",
    "katex": "^0.19.1",
    "lucide-react": "^1.61.0",
    "mdast-util-mdx-jsx": "^3.2.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-autolink-headings": "^7.1.0",
