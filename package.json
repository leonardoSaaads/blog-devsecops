{
  "name": "blog-devsecops",
  "version": "2.0.0",
  "private": true,
  "description": "An interactive technical blog on telecommunications, infrastructure, security and software.",
  "license": "MIT",
  "author": "Leonardo Saads Pinto",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "images": "node scripts/optimize-images.mts",
    "dev": "npm run images && next dev",
    "build": "npm run images && next build",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.1",
